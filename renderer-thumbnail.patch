+    /// A bounded page preview, using the renderer's rotated crop-box geometry.
+    /// Shared by the headless preview tool and Windows Explorer's thumbnail provider.
+    pub fn thumbnail(&mut self, page: usize, max_side: u32) -> Result<RenderedPage, String> {
+        if !(1..=4096).contains(&max_side) {
+            return Err("thumbnail size must be between 1 and 4096 pixels".into());
+        }
+        let scale = catch_unwind(AssertUnwindSafe(|| {
+            let pdf = self.pdf.as_ref().ok_or("the document could not be parsed")?;
+            let page = pdf.pages().get(page).ok_or("page is out of range")?;
+            let (w, h) = page.render_dimensions();
+            if !w.is_finite() || !h.is_finite() || w < 0.5 || h < 0.5 {
+                return Err("page has invalid dimensions");
+            }
+            Ok((max_side as f32 / w.max(h)).min(1.0))
+        }))
+        .map_err(|_| "thumbnail geometry could not be read".to_string())?
+        .map_err(str::to_owned)?;
+        let out = self.render(RenderRequest { page, scale, ..Default::default() });
+        if let Some(error) = &out.error {
+            return Err(error.clone());
+        }
+        if out.width == 0 || out.height == 0 || out.width > max_side || out.height > max_side {
+            return Err("thumbnail exceeds the requested dimensions".into());
+        }
+        Ok(out)
+    }
