+    fn thumbnails_fit_the_requested_box_and_preserve_page_rotation() {
+        for rotation in [0, 90, 180, 270] {
+            let source = String::from_utf8(ONE_PAGE.to_vec()).unwrap()
+                .replace("/MediaBox [0 0 100 50]", &format!("/MediaBox [0 0 100 50] /Rotate {rotation}"));
+            let mut renderer = PageRenderer::new(Arc::new(source.into_bytes()), RenderConfig::default());
+            for max_side in [1, 32, 64, 256, 1024] {
+                let page = renderer.thumbnail(0, max_side).unwrap();
+                assert!(page.width <= max_side && page.height <= max_side);
+                assert_eq!(page.rgba.len(), page.width as usize * page.height as usize * 4);
+                if max_side > 1 {
+                    assert_eq!(page.width > page.height, rotation % 180 == 0);
+                }
+            }
+        }
+    }
